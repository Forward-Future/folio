{
  "name": "folio-pdf-reader",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "assets": "node scripts/copy-pdfjs-assets.mjs",
    "predev": "npm run assets",
    "prebuild": "npm run assets",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "app": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "productName": "Folio",
  "description": "A simple, clean PDF reader for Windows",
  "license": "MIT",
  "homepage": "https://github.com/mberman84/folio",
  "bugs": {
    "url": "https://github.com/mberman84/folio/issues"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "app.folio.reader",
    "productName": "Folio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Folio",
      "artifactName": "Folio-Setup.exe"
    },
    "portable": {
      "artifactName": "Folio-Portable.exe"
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "description": "PDF Document",
        "role": "Viewer",
        "icon": "build/icon.png"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "mberman84",
        "repo": "folio-releases",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mberman84/folio.git"
  },
  "author": "mberman84"
}
