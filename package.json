{
  "name": "folio-pdf-reader",
  "private": true,
  "version": "1.11.0",
  "type": "module",
  "scripts": {
    "assets": "node scripts/copy-pdfjs-assets.mjs",
    "predev": "npm run assets",
    "prebuild": "npm run assets",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "app": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "release": "node scripts/release.mjs",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "smoke": "node scripts/smoke-test.mjs",
    "test:chat-math": "node scripts/test-chat-math.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "katex": "^0.19.1",
    "mdast-util-from-markdown": "^2.1.0",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-math": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "productName": "Folio",
  "description": "A simple, clean PDF reader for Windows, macOS, and Linux",
  "license": "MIT",
  "homepage": "https://github.com/Forward-Future/folio",
  "bugs": {
    "url": "https://github.com/Forward-Future/folio/issues"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "app.folio.reader",
    "productName": "Folio",
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/mammoth/mammoth.browser*.js"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Folio",
      "artifactName": "Folio-Setup.exe"
    },
    "portable": {
      "artifactName": "Folio-Portable.exe"
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "description": "PDF Document",
        "role": "Viewer",
        "icon": "build/icon.png"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Forward-Future",
        "repo": "folio-releases",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "dist/.vite/license.md",
        "to": "licenses/THIRD_PARTY_LICENSES.md"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "fileAssociations": [
        {
          "ext": [
            "docx",
            "doc"
          ],
          "name": "Word Document",
          "role": "Viewer",
          "rank": "Alternate"
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Folio-mac.${ext}"
    },
    "dmg": {
      "artifactName": "Folio-mac.dmg"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "synopsis": "A simple, clean PDF reader",
      "maintainer": "Forward Future <748450+mberman84@users.noreply.github.com>",
      "mimeTypes": [
        "application/pdf",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "application/msword"
      ],
      "executableName": "folio",
      "syncDesktopName": true,
      "extraResources": [
        {
          "from": "build/linux/folio-archive-keyring.gpg",
          "to": "folio-archive-keyring.gpg"
        }
      ]
    },
    "appImage": {
      "artifactName": "Folio-linux-x86_64.AppImage"
    },
    "deb": {
      "artifactName": "Folio-linux-amd64.deb",
      "afterInstall": "build/linux/after-install.tpl",
      "afterRemove": "build/linux/after-remove.tpl"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Forward-Future/folio.git"
  },
  "author": "Forward Future",
  "desktopName": "folio-pdf-reader.desktop",
  "overrides": {
    "katex": "$katex"
  }
}
